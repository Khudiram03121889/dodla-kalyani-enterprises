      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/kalyani_enterprise_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "bf815917-7d0a-40b7-9684-a108af3f42f7"
      }
    },
    "owner": "gramaone2021s-team"
  }
